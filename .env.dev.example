# ═══════════════════════════════════════════════════════════════
# GX-Daemon DEV configuration
# ═══════════════════════════════════════════════════════════════
# Copy to .env.dev and edit values for your environment.
# Run: make run-dev   (or make reload-dev for --reload)
# Portal: dev-api.genolyx.com → daemon host port 8011
# ═══════════════════════════════════════════════════════════════

# ─── Application ──────────────────────────────────────────────
APP_NAME=gx-daemon
APP_ENV=dev
LOG_LEVEL=INFO

# ─── Platform API (dev Portal) ─────────────────────────────────
PLATFORM_API_BASE=https://dev-api.genolyx.com
AUTH_URL=https://dev-api.genolyx.com/auth/login
PLATFORM_API_ENABLED=true
API_USERNAME=daemon-user
API_PASSWORD=changeme
# API_KEY=

# ─── Queue / Worker ──────────────────────────────────────────────
MAX_CONCURRENT_JOBS=2
QUEUE_POLL_INTERVAL=30

# ─── Enabled Services ────────────────────────────────────────────
ENABLED_SERVICES=carrier_screening,whole_exome,health_screening,sgnipt,nipt

# ─── Base Directories ────────────────────────────────────────────
BASE_DIR=/data
FASTQ_BASE_DIR=/data/fastq
ANALYSIS_BASE_DIR=/data/analysis
OUTPUT_BASE_DIR=/data/output
LOG_BASE_DIR=/data/log
# ORDERS_DB_PATH=/data/service-daemon/orders.db
# LITERATURE_DB_PATH=/data/service-daemon/literature.db

# ─── Carrier Screening ───────────────────────────────────────────
CARRIER_SCREENING_HOST=/home/ken/gx-exome
CARRIER_SCREENING_FASTQ_DIR=/data/gx-exome/fastq
CARRIER_SCREENING_PIPELINE_DIR=/opt/pipelines/carrier-screening
CARRIER_SCREENING_ARTIFACT_BASE=/data/gx-exome-work

# ─── NIPT ────────────────────────────────────────────────────────
NIPT_ROOT_DIR=/home/ken/gx-nipt-data
NIPT_FASTQ_DIR=/home/ken/gx-nipt-data/fastq
NIPT_ANALYSIS_DIR=/home/ken/gx-nipt-data/analysis
NIPT_OUTPUT_DIR=/home/ken/gx-nipt-data/output
NIPT_LOG_DIR=/home/ken/gx-nipt-data/log
NIPT_CONFIG_DIR=/home/ken/gx-nipt-data/config
NIPT_PIPELINE_DIR=/home/ken/gx-nipt
NIPT_REF_DIR=/data/reference
NIPT_REPORT_ENGINE=pptx

# ─── sgNIPT ──────────────────────────────────────────────────────
SGNIPT_SRC_HOST=/home/ken/sgnipt
SGNIPT_LAYOUT_HOST=/home/ken/sgNIPT
SGNIPT_PIPELINE_DIR=/opt/pipelines/sgnipt
SGNIPT_WORK_ROOT=/data/sgnipt_work

# ─── Nextflow ────────────────────────────────────────────────────
NEXTFLOW_EXECUTABLE=nextflow

# ─── AI Classification ───────────────────────────────────────────
ACMG_AI_ENABLED=false

# ─── Host/Container (docker compose) ─────────────────────────────
# id -u → HOST_UID; id -g → HOST_GID; getent group docker | cut -d: -f3 → DOCKER_GID
TZ=Asia/Seoul
HOST_UID=1000
HOST_GID=1000
DOCKER_GID=999

# ─── Ports ───────────────────────────────────────────────────────
# Container listens on APP_PORT (8000). Host exposes HOST_PORT (8011 for dev).
HOST_PORT=8011
APP_PORT=8000

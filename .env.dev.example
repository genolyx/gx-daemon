# =============================================================================
# gx-daemon — DEV 환경 설정 샘플
#
# 사용법: cp .env.dev.example .env.dev  →  값 편집 후 make run-dev
#
# ▶ 연동 단계별 빠른 가이드
#
#  [단계 1] Gx-Portal (dev) + NIPT 서비스 테스트
#   - dev-gx-daemon → gx-nipt (NIPT 테스트용)
#   → PLATFORM_API_ENABLED=false (결과 통보 불필요 시 권장)
#   → ENABLED_SERVICES=nipt  로 좁히면 불필요한 서비스 슬롯 낭비 없음
#
#  [단계 2] Test Portal (service-daemon) + gx-daemon dev 연결
#   - Test Portal → dev-gx-daemon → exome/sgnipt
#   → Test Portal이 callback_url=http://hostname:8003 을 자동 포함해서 전송
#   → PLATFORM_API_ENABLED=false 여도 callback_url 경로로 알림 전송됨
#
#  prod와 dev를 동시에 띄울 때 리소스 합산 고려:
#   prod NIPT 4 + dev NIPT 2 + prod exome 2 + dev exome 1 = CPU 과부하 가능
#   → dev 한도를 prod보다 낮게 유지 (아래 기본값 참고)
# =============================================================================

# ===== Runtime =====
APP_NAME=gx-daemon
APP_ENV=dev
LOG_LEVEL=INFO

# ===== Platform API (dev) =====
# PLATFORM_API_ENABLED=false → 결과 통보 생략 (로컬 테스트 시 권장)
# PLATFORM_API_ENABLED=true  → dev Portal 인증 정보 입력 필요
PLATFORM_API_BASE=https://dev-api.genolyx.com
AUTH_URL=https://dev-api.genolyx.com/auth/login
PLATFORM_API_ENABLED=false
API_USERNAME=           # dev Portal 계정
API_PASSWORD=           # dev Portal 비밀번호
# API_KEY=

# ===== Queue / Worker =====
# dev는 prod보다 낮게 유지 (prod와 동시 실행 고려)
MAX_CONCURRENT_JOBS=4

# 서비스 그룹별 동시 실행 한도
# [단계 1] NIPT 테스트만 → nipt=2, exome=0, sgnipt=0
# [단계 2] Test Portal exome/sgnipt 테스트 → nipt=1, exome=1, sgnipt=1
#
# ── MAX_CONCURRENT_NIPT 와 gx-nipt 내부 리소스 (prod .env 주석과 동일 근거) ──
# gx-daemon은 slot 수만 제한; max_cpus 등 gx-nipt 파라미터는 자동 조절하지 않음.
# gx-nipt 내부 (nextflow.config): max_cpus=32, BWA_ALIGN 64G limit, Picard 20G,
#   samtools (max_cpus-1)×2G, downsample=R1>13M일 때만 7.5M.
# prod 벤치 (128 CPU / 251 GB): slot=4 → 8/8 SUCCESS, BWA peak ~180 GB;
#   8 blind launch → OOM 다수. prod MAX_CONCURRENT_NIPT=4 권장.
# dev는 prod와 동시 기동 시 합산 RAM/CPU 고려 → 기본 2 (prod 4 + dev 2 동시 가능).
MAX_CONCURRENT_NIPT=2
MAX_CONCURRENT_EXOME=1
MAX_CONCURRENT_SGNIPT=1

# NIPT 우선순위 모드 (dev는 소수 샘플 테스트이므로 보통 false)
# 재시작 없이 전환: PATCH /config/priority {"nipt_priority": true|false}
NIPT_PRIORITY=false
MAX_CONCURRENT_NIPT_PRIORITY=4

QUEUE_POLL_INTERVAL=30

# ===== Enabled Services =====
# [단계 1] NIPT 테스트만:
#   ENABLED_SERVICES=nipt
# [단계 2] exome/sgnipt 테스트:
#   ENABLED_SERVICES=carrier_screening,whole_exome,health_screening,sgnipt
# [전체 활성]:
ENABLED_SERVICES=carrier_screening,whole_exome,health_screening,sgnipt,nipt

# ===== Base Directories =====
BASE_DIR=/data
FASTQ_BASE_DIR=/data/fastq
ANALYSIS_BASE_DIR=/data/analysis
OUTPUT_BASE_DIR=/data/output
LOG_BASE_DIR=/data/log
ORDERS_DB_PATH=/data/service-daemon/orders.db
LITERATURE_DB_PATH=/data/gx-daemon/literature.db

# ===== Carrier Screening =====
CARRIER_SCREENING_HOST=/home/user/gx-exome
CARRIER_SCREENING_FASTQ_DIR=/data/gx-exome/fastq
CARRIER_SCREENING_PIPELINE_DIR=/opt/pipelines/carrier-screening
CARRIER_SCREENING_ARTIFACT_BASE=/data/gx-exome-work

# ===== WES interpretation panels =====
WES_PANELS_CUSTOM_JSON=/data/wes_panels/wes_panels_custom.json
WES_PANELS_GENERATED_DIR=/data/wes_panels/generated

# ===== NIPT =====
NIPT_ROOT_DIR=/home/user/gx-nipt-data
NIPT_FASTQ_DIR=/home/user/gx-nipt-data/fastq
NIPT_ANALYSIS_DIR=/home/user/gx-nipt-data/analysis
NIPT_OUTPUT_DIR=/home/user/gx-nipt-data/output
NIPT_LOG_DIR=/home/user/gx-nipt-data/log
NIPT_CONFIG_DIR=/home/user/gx-nipt-data/config
NIPT_PIPELINE_DIR=/home/user/gx-nipt
NIPT_REF_DIR=/data/reference
NIPT_REPORT_ENGINE=pptx

# ===== sgNIPT =====
SGNIPT_SRC_HOST=/home/user/sgnipt
SGNIPT_LAYOUT_HOST=/home/user/sgNIPT
SGNIPT_PIPELINE_DIR=/opt/pipelines/sgnipt
SGNIPT_WORK_ROOT=/data/sgnipt_work
SGNIPT_DATA_DIR=/home/user/sgNIPT/data
SGNIPT_CONFIG_DIR=/home/user/sgNIPT/config
SGNIPT_FASTQ_DIR=/home/user/sgNIPT/fastq

# ===== Nextflow =====
NEXTFLOW_EXECUTABLE=nextflow

# ===== AI Classification =====
ACMG_AI_ENABLED=false
ACMG_AI_PROVIDER=gemini
ACMG_AI_MODEL=gemini-2.0-flash
# GEMINI_API_KEY=       # 민감정보 — .env.dev에만 입력, 여기엔 공란
GENE_KNOWLEDGE_DB=/data/gx-daemon/gene_knowledge.db

# ===== Annotation Resources =====
CLINVAR_VCF=/data/reference/annotation/clinvar/clinvar.vcf.gz
GNOMAD_DIR=/data/reference/annotation/gnomad
GNOMAD_GENOMES_GLOB=gnomad.genomes.v*.sites*.bgz
HGMD_VCF=/data/reference/annotation/hgmd/hgmd_YYYY_vX_hg38.vcf.gz
MANE_GFF=/data/reference/annotation/mane/MANE.GRCh38.v1.3.ensembl_genomic.gff

# ===== Host/Container (compose) =====
# id -u         → HOST_UID
# id -g         → HOST_GID
# getent group docker | cut -d: -f3  → DOCKER_GID
TZ=Asia/Seoul
HOST_UID=1000
HOST_GID=1000
DOCKER_GID=999

# ===== Ports (dev: host 8011 → container 8000) =====
HOST_PORT=8011
APP_PORT=8000

# ═══════════════════════════════════════════════════════════════
# GX-Daemon Configuration
# ═══════════════════════════════════════════════════════════════
# Copy to .env and edit values for your environment.
# ═══════════════════════════════════════════════════════════════

# ─── Application ──────────────────────────────────────────────
APP_NAME=gx-daemon
APP_ENV=dev
APP_PORT=8000
LOG_LEVEL=INFO

# Inbound API key (optional; enables Bearer / X-API-Key guard)
# API_KEY=

# ─── Platform API (Genolyx) ──────────────────────────────────
PLATFORM_API_BASE=https://api.genolyx.com
AUTH_URL=https://api.genolyx.com/auth/login
PLATFORM_API_ENABLED=true
API_USERNAME=daemon-user
API_PASSWORD=changeme

# ─── Queue / Worker ──────────────────────────────────────────
MAX_CONCURRENT_JOBS=2
QUEUE_POLL_INTERVAL=30

# ─── Telegram (optional) ─────────────────────────────────────
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_IDS=
# TELEGRAM_NOTIFY_ENABLED=true

# ─── Enabled Services ────────────────────────────────────────
ENABLED_SERVICES=carrier_screening,whole_exome,health_screening,sgnipt

# ─── Base Directories ────────────────────────────────────────
BASE_DIR=/data
FASTQ_BASE_DIR=/data/fastq
ANALYSIS_BASE_DIR=/data/analysis
OUTPUT_BASE_DIR=/data/output
LOG_BASE_DIR=/data/log

# ─── Carrier Screening ───────────────────────────────────────
CARRIER_SCREENING_FASTQ_DIR=/home/ken/gx-exome/fastq
CARRIER_SCREENING_PIPELINE_DIR=/opt/pipelines/carrier-screening
# CARRIER_SCREENING_RUN_SCRIPT=/path/to/run_analysis.sh
# CARRIER_SCREENING_ARTIFACT_BASE=/data/gx-exome-work

# ─── Nextflow ─────────────────────────────────────────────────
NEXTFLOW_EXECUTABLE=nextflow

# ─── Reference Data ──────────────────────────────────────────
# REF_FASTA=/data/reference/GRCh38.fa
# CLINVAR_VCF=/data/reference/clinvar.vcf.gz
# GNOMAD_VCF=/data/reference/gnomad.vcf.gz
# SNPEFF_JAR=/opt/tools/snpEff/snpEff.jar

# ─── NIPT Report ─────────────────────────────────────────────
# Engine: "pptx" (legacy PPTX template → LibreOffice PDF) or "html" (Jinja2 HTML → WeasyPrint PDF)
NIPT_REPORT_ENGINE=pptx
# NIPT_REPORT_HTML_TEMPLATE_DIR=/home/ken/gx-daemon/data/nipt_report_html

# ─── AI Classification ───────────────────────────────────────
ACMG_AI_ENABLED=false
# GEMINI_API_KEY=

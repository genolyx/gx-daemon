# ═══════════════════════════════════════════════════════════════
# GX-Daemon Configuration
# ═══════════════════════════════════════════════════════════════
# Copy to .env and edit values for your environment.
# ═══════════════════════════════════════════════════════════════

# ─── Application ──────────────────────────────────────────────
APP_NAME=gx-daemon
APP_ENV=dev
APP_PORT=8000
LOG_LEVEL=INFO

# Inbound API key (optional; enables Bearer / X-API-Key guard)
# API_KEY=

# ─── Platform API (Genolyx) ──────────────────────────────────
PLATFORM_API_BASE=https://api.genolyx.com
AUTH_URL=https://api.genolyx.com/auth/login
PLATFORM_API_ENABLED=true
API_USERNAME=daemon-user
API_PASSWORD=changeme

# ─── Queue / Worker ──────────────────────────────────────────
MAX_CONCURRENT_JOBS=2
QUEUE_POLL_INTERVAL=30

# ─── Telegram (optional) ─────────────────────────────────────
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_IDS=
# TELEGRAM_NOTIFY_ENABLED=true

# ─── Enabled Services ────────────────────────────────────────
# Keep ``nipt`` enabled so Platform orders with type="NIPT" are routed
# to the gx-nipt Nextflow pipeline.
ENABLED_SERVICES=carrier_screening,whole_exome,health_screening,sgnipt,nipt

# ─── Base Directories ────────────────────────────────────────
BASE_DIR=/data
FASTQ_BASE_DIR=/data/fastq
ANALYSIS_BASE_DIR=/data/analysis
OUTPUT_BASE_DIR=/data/output
LOG_BASE_DIR=/data/log

# ─── Carrier Screening ───────────────────────────────────────
CARRIER_SCREENING_FASTQ_DIR=/home/ken/gx-exome/fastq
CARRIER_SCREENING_PIPELINE_DIR=/opt/pipelines/carrier-screening
# CARRIER_SCREENING_RUN_SCRIPT=/path/to/run_analysis.sh
# CARRIER_SCREENING_ARTIFACT_BASE=/data/gx-exome-work
# Force Run (Fresh): run_analysis 에 --nf-live-log 를 자동 추가(라이브 process 표). 조용한 로그는 false.
# CARRIER_SCREENING_FRESH_APPEND_NF_LIVE_LOG=true

# ─── Nextflow ─────────────────────────────────────────────────
NEXTFLOW_EXECUTABLE=nextflow

# ─── Reference Data ──────────────────────────────────────────
# REF_FASTA=/data/reference/GRCh38.fa
# CLINVAR_VCF=/data/reference/clinvar.vcf.gz
# GNOMAD_VCF=/data/reference/gnomad.vcf.gz
# SNPEFF_JAR=/opt/tools/snpEff/snpEff.jar

# ─── NIPT (gx-nipt / Nextflow) ───────────────────────────────
# Directory layout created/used by bin/run_nipt.sh and NIPTPlugin:
#   ${NIPT_ROOT_DIR}/fastq/<work>/<order>/R[12].fastq.gz
#   ${NIPT_ROOT_DIR}/analysis/<work>/<order>/
#   ${NIPT_ROOT_DIR}/output/<work>/<order>/<order>.json
#   ${NIPT_ROOT_DIR}/log/<work>/<order>/pipeline.log
#   ${NIPT_ROOT_DIR}/config/<labcode>/pipeline_config.json
NIPT_ROOT_DIR=/home/ken/gx-nipt-data
NIPT_FASTQ_DIR=/home/ken/gx-nipt-data/fastq
NIPT_ANALYSIS_DIR=/home/ken/gx-nipt-data/analysis
NIPT_OUTPUT_DIR=/home/ken/gx-nipt-data/output
NIPT_LOG_DIR=/home/ken/gx-nipt-data/log
NIPT_CONFIG_DIR=/home/ken/gx-nipt-data/config

# gx-nipt source checkout (must contain main.nf and bin/run_nipt.sh)
NIPT_PIPELINE_DIR=/home/ken/gx-nipt
# NIPT_RUN_SCRIPT=/home/ken/gx-nipt/bin/run_nipt.sh

# Fallback labcode when Platform DTO does not supply one
# NIPT_DEFAULT_LABCODE=CORDLIFE

# Reference data root (bind-mounted read-only into the gx-nipt container
# at the same path). Expected subtree:
#   ${NIPT_REF_DIR}/genomes/hg19/hg19.fa(+ .fai, .0123, .amb, .ann, .bwt.2bit.64, .pac)
#   ${NIPT_REF_DIR}/hmmcopy/hg19.{50kb,10mb}.{gc,map}.wig
#   ${NIPT_REF_DIR}/models/seqff_model.pkl
#   ${NIPT_REF_DIR}/labs/<labcode>/{WC,WCX,EZD,PRIZM}/<group>/...
#   ${NIPT_REF_DIR}/labs/<labcode>/bed/...
NIPT_REF_DIR=/data/reference

# SSD scratch profile (optional)
NIPT_USE_SSD=false
# NIPT_SCRATCH_DIR=/tmp/nipt_scratch
# NIPT_SSD_MAX_USAGE_GB=200

# gx-FF / gx-cnv overrides — BOTH DEFERRED
#   * Training / reference-building happens in the genolyx/gx-FF and
#     genolyx/gx-cnv repos. Artefacts do not exist yet.
#   * Leave these env vars commented out: gx-nipt will automatically
#     fall back to seqFF-only FF and WisecondorX-only CNV calling.
#   * Once the .pkl model / .npz reference are published, uncomment
#     the matching line and gx-daemon will start passing --gxff-model
#     / --gxcnv-reference to run_nipt.sh on the next order.
# NIPT_GXFF_MODEL=/data/reference/models/gxff_model.pkl
# NIPT_GXCNV_REFERENCE=/data/reference/gxcnv/hg19_panel.npz
# NIPT_GXCNV_MODEL=/data/reference/gxcnv/hg19_panel.npz   # alias of above
# NIPT_RUN_WCX=true                                       # flip to false only after gx-cnv concordance is validated

# ─── NIPT Report ─────────────────────────────────────────────
# Engine: "pptx" (legacy PPTX template → LibreOffice PDF) or "html" (Jinja2 HTML → WeasyPrint PDF)
NIPT_REPORT_ENGINE=pptx
# NIPT_REPORT_HTML_TEMPLATE_DIR=/home/ken/gx-daemon/data/nipt_report_html

# ─── AI Classification ───────────────────────────────────────
ACMG_AI_ENABLED=false
# GEMINI_API_KEY=

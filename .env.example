# =============================================================================
# gx-daemon — PROD 환경 설정 샘플
#
# 사용법: cp .env.example .env  →  값 편집 후 make run-prod
#
# ▶ 연동 단계별 빠른 가이드 (Queue / Worker 섹션 참고)
#
#  [단계 1] nipt-daemon 공존 (현재)
#   - Cloud Portal  → nipt-daemon → ken-nipt   (NIPT 전용)
#   - Test Portal   → gx-daemon  → gx-exome / gx-sgnipt
#   → ENABLED_SERVICES에서 nipt 제거 또는 MAX_CONCURRENT_NIPT=0
#   → nipt-daemon + gx-daemon 합산 리소스 고려해 exome/sgnipt 한도 낮게 유지
#
#  [단계 2] 두 Portal이 gx-daemon 하나에 연결 (과도기)
#   - Cloud Portal  → gx-daemon → gx-nipt       (callback_url 없음 → PLATFORM_API_BASE 사용)
#   - Test Portal   → gx-daemon → gx-exome/sgnipt (callback_url=service-daemon:8003 자동 설정)
#   → ENABLED_SERVICES=carrier_screening,whole_exome,health_screening,sgnipt,nipt
#   → NIPT_PRIORITY=true 권장 (NIPT 대량 유입 시 우선 처리)
#   → 재시작 없이 전환: PATCH /config/priority {"nipt_priority": true|false}
#
#  [단계 3] 단일 Portal + gx-daemon (최종)
#   - Cloud Portal  → gx-daemon → 모든 서비스
#   → PLATFORM_API_BASE = Cloud Portal API 주소
#   → callback_url 불필요 (Portal이 보내지 않으면 PLATFORM_API_BASE로 자동 fallback)
# =============================================================================

# ===== Runtime =====
APP_NAME=gx-daemon
APP_ENV=prod
LOG_LEVEL=INFO

# ===== Platform API =====
# 결과 통보를 받을 Portal의 API base URL
PLATFORM_API_BASE=https://api.genolyx.com
AUTH_URL=https://api.genolyx.com/auth/login
PLATFORM_API_ENABLED=true
API_USERNAME=           # Portal에서 발급한 daemon 계정
API_PASSWORD=           # 위 계정 비밀번호
# API_KEY=              # Bearer / X-API-Key 방식 사용 시

# ===== Queue / Worker =====
# ─ 전체 동시 실행 수 = 아래 그룹 합계와 맞추는 것 권장 ─
MAX_CONCURRENT_JOBS=8

# 서비스 그룹별 동시 실행 한도
#   nipt  : gx-nipt (경량, ~30분)
#   exome : carrier_screening / whole_exome / health_screening (exome 기반, CPU/RAM 무거움)
#   sgnipt: Single-gene NIPT (exome 수준이나 carrier보다 가벼움)
#
# [단계 1] nipt-daemon과 공존 → nipt 제외, exome 낮게
#   MAX_CONCURRENT_NIPT=0
#   MAX_CONCURRENT_EXOME=2
#   MAX_CONCURRENT_SGNIPT=1
#
# [단계 2~3] gx-daemon이 NIPT까지 전담 → 서버 스펙에 맞게 조정
#   MAX_CONCURRENT_NIPT=4
#   MAX_CONCURRENT_EXOME=2
#   MAX_CONCURRENT_SGNIPT=1
#
# ── MAX_CONCURRENT_NIPT=4 와 gx-nipt 내부 리소스 (벤치마크 근거) ──
# 이 값은 NIPT job 동시 launch 수(slot-pool)만 제한한다. gx-daemon은 max_cpus 등
# gx-nipt 파라미터를 자동 조절하지 않는다 (run_nipt.sh → nextflow.config 기본값).
#
# gx-nipt 파이프라인 내부 (nextflow.config / modules; daemon 미전달):
#   params.max_cpus       = 32        → BWA-MEM2 -t (modules/bwa.nf)
#   BWA_ALIGN container   = cpus 32, memory limit 64G  ← RAM 병목 단계
#   samtools sort         = (max_cpus-1) threads × 2G (-m)
#   Picard MarkDuplicates = -Xmx 20G (modules/picard.nf 기본)
#   downsample            = R1 > 13M reads 일 때만 7.5M으로 축소 (cordlife QC config)
#
# 벤치 (128 CPU / 251 GB, 2603 batch, gx-nipt FASTQ full pipeline):
#   slot=4 + max_cpus=16 (수동 지정): 8/8 SUCCESS, batch ~16min, BWA peak ~180 GB
#   8 parallel blind launch (max_cpus=16): 5/8 FAILED — BWA OOM / truncated pipe
#   8 parallel blind launch (max_cpus=8):  7/8 FAILED — 동일 패턴
#   → 251 GB 서버에서 NIPT slot 4 = 안정 운영 기준. 8 blind launch는 ken/gx 공통 OOM 위험.
#
# 참고: 벤치 권장 max_cpus=16은 nextflow.config 기본(32)과 다르다. daemon 경로는
# --max_cpus를 넘기지 않으므로 실제 BWA peak는 벤치(16 thread)보다 높을 수 있다.
# slot=4는 그 여유를 감안한 값이다. slot ↑ 시 BWA peak(샘플당 ~26–45 GB)가 합산된다.
MAX_CONCURRENT_NIPT=4
MAX_CONCURRENT_EXOME=2
MAX_CONCURRENT_SGNIPT=1

# NIPT 우선순위 모드
# true  → NIPT 잡을 먼저 처리 (Priority Queue) + NIPT 동시 실행 수를 PRIORITY 값으로 확장
#          대량 NIPT 배치가 들어올 때 exome이 슬롯을 선점하지 못하도록 막음
# false → 균등 FIFO 모드 (서비스별 한도만 적용, 제출 순서대로 처리)
#
# [단계 1] false  (nipt-daemon이 NIPT 담당)
# [단계 2] true   (Cloud Portal NIPT 대량 + Test Portal exome 동시 수신 대비)
# [단계 3] 트래픽 패턴에 따라 선택
NIPT_PRIORITY=false
MAX_CONCURRENT_NIPT_PRIORITY=8   # NIPT_PRIORITY=true 일 때 NIPT 동시 실행 수

QUEUE_POLL_INTERVAL=30

# ===== Enabled Services =====
# [단계 1] nipt-daemon 공존 시 nipt 제거 권장:
#   ENABLED_SERVICES=carrier_screening,whole_exome,health_screening,sgnipt
# [단계 2~3] 전체 서비스:
ENABLED_SERVICES=carrier_screening,whole_exome,health_screening,sgnipt,nipt

# ===== Base Directories =====
BASE_DIR=/data
FASTQ_BASE_DIR=/data/fastq
ANALYSIS_BASE_DIR=/data/analysis
OUTPUT_BASE_DIR=/data/output
LOG_BASE_DIR=/data/log
ORDERS_DB_PATH=/data/service-daemon/orders.db
LITERATURE_DB_PATH=/data/gx-daemon/literature.db

# ===== Carrier Screening =====
# CARRIER_SCREENING_HOST : 호스트의 gx-exome repo 경로 (compose bind-mount 원본; nested docker -v 에 전달)
# CARRIER_SCREENING_FASTQ_DIR : 컨테이너 내부 FASTQ 루트 (/data/gx-exome alias)
CARRIER_SCREENING_HOST=/home/user/gx-exome
CARRIER_SCREENING_FASTQ_DIR=/data/gx-exome/fastq
CARRIER_SCREENING_PIPELINE_DIR=/opt/pipelines/carrier-screening
CARRIER_SCREENING_ARTIFACT_BASE=/data/gx-exome-work

# ===== WES interpretation panels =====
WES_PANELS_CUSTOM_JSON=/data/wes_panels/wes_panels_custom.json
WES_PANELS_GENERATED_DIR=/data/wes_panels/generated

# ===== NIPT =====
# [단계 1] nipt-daemon이 담당 → 이 값은 사용되지 않음 (ENABLED_SERVICES에서 nipt 제외 시)
# [단계 2~3] gx-daemon이 NIPT 담당 → 아래 경로가 실제 사용됨
NIPT_ROOT_DIR=/home/user/gx-nipt-data
NIPT_FASTQ_DIR=/home/user/gx-nipt-data/fastq
NIPT_ANALYSIS_DIR=/home/user/gx-nipt-data/analysis
NIPT_OUTPUT_DIR=/home/user/gx-nipt-data/output
NIPT_LOG_DIR=/home/user/gx-nipt-data/log
NIPT_CONFIG_DIR=/home/user/gx-nipt-data/config
NIPT_PIPELINE_DIR=/home/user/gx-nipt
NIPT_REF_DIR=/data/reference
NIPT_REPORT_ENGINE=pptx
# NIPT_USE_SSD=false
# NIPT_GXFF_MODEL=/data/reference/models/gxff_model.pkl
# NIPT_GXCNV_REFERENCE=/data/reference/gxcnv/panel.npz

# ===== sgNIPT =====
SGNIPT_SRC_HOST=/home/user/sgnipt
SGNIPT_LAYOUT_HOST=/home/user/sgNIPT
SGNIPT_PIPELINE_DIR=/opt/pipelines/sgnipt
SGNIPT_WORK_ROOT=/data/sgnipt_work
# Host paths for nested docker -v in run_sgnipt.sh
SGNIPT_DATA_DIR=/home/user/sgNIPT/data
SGNIPT_CONFIG_DIR=/home/user/sgNIPT/config
SGNIPT_FASTQ_DIR=/home/user/sgNIPT/fastq

# ===== Nextflow =====
NEXTFLOW_EXECUTABLE=nextflow

# ===== AI Classification =====
ACMG_AI_ENABLED=false
ACMG_AI_PROVIDER=gemini
ACMG_AI_MODEL=gemini-2.0-flash
# GEMINI_API_KEY=       # Gemini API 키 (민감정보 — .env에만 입력, 여기엔 공란)
GENE_KNOWLEDGE_DB=/data/gx-daemon/gene_knowledge.db

# ===== Annotation Resources =====
CLINVAR_VCF=/data/reference/annotation/clinvar/clinvar.vcf.gz
GNOMAD_DIR=/data/reference/annotation/gnomad
GNOMAD_GENOMES_GLOB=gnomad.genomes.v*.sites*.bgz
HGMD_VCF=/data/reference/annotation/hgmd/hgmd_YYYY_vX_hg38.vcf.gz
MANE_GFF=/data/reference/annotation/mane/MANE.GRCh38.v1.3.ensembl_genomic.gff

# ===== Host/Container (compose) =====
# id -u         → HOST_UID
# id -g         → HOST_GID
# getent group docker | cut -d: -f3  → DOCKER_GID
TZ=Asia/Seoul
HOST_UID=1000
HOST_GID=1000
DOCKER_GID=999

# ===== Ports (prod: host 8010 → container 8000) =====
HOST_PORT=8010
APP_PORT=8000

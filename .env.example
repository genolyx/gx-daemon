# ═══════════════════════════════════════════════════════════════
# GX-Daemon PROD configuration
# ═══════════════════════════════════════════════════════════════
# Copy to .env and edit values for your environment.
# For dev Portal use .env.dev (see .env.dev.example).
#
# Run:
#   make run-prod    # prod Portal → api.genolyx.com, host :8010
#   make run-dev     # dev Portal  → dev-api.genolyx.com, host :8011
#   make reload-dev  # dev with uvicorn --reload (local coding)
# ═══════════════════════════════════════════════════════════════

# ─── Application ──────────────────────────────────────────────
APP_NAME=gx-daemon
APP_ENV=prod
LOG_LEVEL=INFO

# ─── Platform API (prod Portal) ──────────────────────────────
PLATFORM_API_BASE=https://api.genolyx.com
AUTH_URL=https://api.genolyx.com/auth/login
PLATFORM_API_ENABLED=true
API_USERNAME=daemon-user
API_PASSWORD=changeme
# API_KEY=

# ─── Queue / Worker ──────────────────────────────────────────
MAX_CONCURRENT_JOBS=2
QUEUE_POLL_INTERVAL=30

# ─── Enabled Services ────────────────────────────────────────
ENABLED_SERVICES=carrier_screening,whole_exome,health_screening,sgnipt,nipt

# ─── Base Directories ────────────────────────────────────────
BASE_DIR=/data
FASTQ_BASE_DIR=/data/fastq
ANALYSIS_BASE_DIR=/data/analysis
OUTPUT_BASE_DIR=/data/output
LOG_BASE_DIR=/data/log
# ORDERS_DB_PATH=/data/service-daemon/orders.db
# LITERATURE_DB_PATH=/data/service-daemon/literature.db

# ─── Carrier Screening ───────────────────────────────────────
# CARRIER_SCREENING_HOST: host repo path (compose bind source; nested docker -v)
# CARRIER_SCREENING_FASTQ_DIR: container-internal FASTQ root (/data/gx-exome alias)
CARRIER_SCREENING_HOST=/home/ken/gx-exome
CARRIER_SCREENING_FASTQ_DIR=/data/gx-exome/fastq
CARRIER_SCREENING_PIPELINE_DIR=/opt/pipelines/carrier-screening
CARRIER_SCREENING_ARTIFACT_BASE=/data/gx-exome-work
# Force Run (Fresh): run_analysis 에 --nf-live-log 를 자동 추가(라이브 process 표). 조용한 로그는 false.
# CARRIER_SCREENING_FRESH_APPEND_NF_LIVE_LOG=true

# ─── Nextflow ─────────────────────────────────────────────────
NEXTFLOW_EXECUTABLE=nextflow

# ─── Reference Data ──────────────────────────────────────────
# REF_FASTA=/data/reference/GRCh38.fa
# CLINVAR_VCF=/data/reference/clinvar.vcf.gz
# GNOMAD_VCF=/data/reference/gnomad.vcf.gz
# SNPEFF_JAR=/opt/tools/snpEff/snpEff.jar

# ─── NIPT (gx-nipt / Nextflow) ───────────────────────────────
NIPT_ROOT_DIR=/home/ken/gx-nipt-data
NIPT_FASTQ_DIR=/home/ken/gx-nipt-data/fastq
NIPT_ANALYSIS_DIR=/home/ken/gx-nipt-data/analysis
NIPT_OUTPUT_DIR=/home/ken/gx-nipt-data/output
NIPT_LOG_DIR=/home/ken/gx-nipt-data/log
NIPT_CONFIG_DIR=/home/ken/gx-nipt-data/config
NIPT_PIPELINE_DIR=/home/ken/gx-nipt
NIPT_REF_DIR=/data/reference
NIPT_USE_SSD=false
# NIPT_GXFF_MODEL=/data/reference/models/gxff_model.pkl
# NIPT_GXCNV_REFERENCE=/data/reference/gxcnv/hg19_panel.npz

# ─── NIPT Report ─────────────────────────────────────────────
NIPT_REPORT_ENGINE=pptx
# NIPT_REPORT_HTML_TEMPLATE_DIR=/home/ken/gx-daemon/data/nipt_report_html

# ─── sgNIPT ──────────────────────────────────────────────────
SGNIPT_SRC_HOST=/home/ken/sgnipt
SGNIPT_LAYOUT_HOST=/home/ken/sgNIPT
SGNIPT_PIPELINE_DIR=/opt/pipelines/sgnipt
SGNIPT_WORK_ROOT=/data/sgnipt_work

# ─── AI Classification ───────────────────────────────────────
ACMG_AI_ENABLED=false
# GEMINI_API_KEY=

# ─── Host/Container (docker compose) ─────────────────────────
# id -u → HOST_UID; id -g → HOST_GID; getent group docker | cut -d: -f3 → DOCKER_GID
TZ=Asia/Seoul
HOST_UID=1000
HOST_GID=1000
DOCKER_GID=999

# ─── Ports ───────────────────────────────────────────────────
# Container listens on APP_PORT (8000). Host exposes HOST_PORT (8010 for prod).
HOST_PORT=8010
APP_PORT=8000
